# --- LLM ---
# Provider usato per interpretare il linguaggio naturale: "anthropic"
# (default, richiede ANTHROPIC_API_KEY) oppure "ollama" (modello locale,
# nessuna chiave richiesta, richiede Ollama in esecuzione con il modello
# indicato in OLLAMA_MODEL gia' scaricato: `ollama pull qwen2.5:7b`).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Usata solo se LLM_PROVIDER=ollama. Endpoint di default di Ollama
# (http://localhost:11434) letto direttamente dalla libreria "ollama".
OLLAMA_MODEL=qwen2.5:7b

# --- Mock AMAPI server (usato di default dal server MCP custom) ---
AMAPI_BASE_URL=http://127.0.0.1:8001
MOCK_ENTERPRISE_ID=enterprises/LC00demo123

# --- Google MCP ufficiale (OPZIONALE) ---
# Se entrambe le variabili sotto sono valorizzate e il file esiste, il backend
# prova a collegarsi davvero al server MCP ufficiale di Google (sola lettura).
# In assenza, il sistema funziona comunque interamente in modalita' mock/demo.
GOOGLE_CREDENTIALS_PATH=
GOOGLE_ENTERPRISE_ID=

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MOCK_SERVER_PORT=8001
